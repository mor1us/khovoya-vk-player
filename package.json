{
  "name": "khvoya",
  "productName": "Хвоя",
  "version": "0.2.4",
  "description": "Свой плеер для музыки ВК без рекламы",
  "main": "out/main/index.js",
  "author": "Мориус",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "cross-env VK_MOCK=1 electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.24",
    "hls.js": "^1.7.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "ru.morius.khvoya",
    "productName": "Хвоя",
    "executableName": "Khvoya",
    "copyright": "Мориус",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json",
      "!**/*.map",
      "!node_modules/ffmpeg-static/ffmpeg"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Хвоя",
      "artifactName": "Khvoya-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Khvoya-Portable-${version}.${ext}"
    },
    "publish": null
  }
}